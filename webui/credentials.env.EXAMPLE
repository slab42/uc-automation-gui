# Copy this file to .env/credentials.env at the repo root (that folder is git-ignored).
# The Credentials page in the web UI creates and edits these sections for you, so a hand-made copy is optional.
#
# Format: [SERVICE:name] with key = value lines. Services: ORG, CUCM, CUC, CUBE, WEBEX, WEBEXORG, REDSKY.
# Every platform section has an org = <organization name> line that matches an [ORG:<name>] section.
# Passwords are stored here and are never shown in the browser.

# A customer organization.
[ORG:customer-a]
created = yes

# Saved CUCM connection (AXL, port 8443). version and schema_version are filled in by the Test button.
[CUCM:lab-cucm]
org = customer-a
server = 10.0.0.10
username = axl_user
password =

# Saved CUC connection (REST, port 443).
[CUC:lab-cuc]
org = customer-a
server = 10.0.0.20
username = cuc_admin
password =

# Named router credential sets for CUBE. A set is not tied to one router.
[CUBE:branch-routers]
org = customer-a
username = admin
password =

# RedSky account.
[REDSKY:customer-redsky]
org = customer-a
username = user@example.com
password =
org_id =
