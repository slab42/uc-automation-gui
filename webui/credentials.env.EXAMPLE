# Copy this file to .env/credentials.env at the repo root (that folder is git-ignored).
# The Credentials page in the web UI creates and edits these sections for you, so a hand-made copy is optional.
#
# Format: [SERVICE:name] with key = value lines. Services: CUCM, CUC, CUBE, WEBEX, REDSKY.
# Passwords are stored here and are never shown in the browser.

# Saved CUCM connection (AXL, port 8443). version and schema_version are filled in by the Test button.
[CUCM:lab-cucm]
server = 10.0.0.10
username = axl_user
password =

# Saved CUC connection (REST, port 443).
[CUC:lab-cuc]
server = 10.0.0.20
username = cuc_admin
password =

# Named router credential sets for CUBE. A set is not tied to one router.
[CUBE:branch-routers]
username = admin
password =

# RedSky account.
[REDSKY:customer-redsky]
username = user@example.com
password =
org_id =
